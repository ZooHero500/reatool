{
  "name": "reatool-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/localize-site.mjs",
    "build:english": "astro build",
    "deploy": "npm run check && npm run build && npm run verify:site && npm run verify:seo && npm run verify:i18n && wrangler pages deploy dist --project-name reatool --branch main",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "verify:case": "node scripts/verify-case.mjs",
    "verify:totp": "node scripts/verify-totp.mjs",
    "verify:labs": "node public/downloads/check-case-labs.mjs > public/evidence/case-lab-checks.json",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.8",
    "slugify": "1.6.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/three": "^0.186.0",
    "parse5": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
