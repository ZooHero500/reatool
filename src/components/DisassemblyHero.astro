<div class="disassembly" data-renderer="static">
  <div class="artifact-fallback" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <canvas aria-hidden="true"></canvas>
  <div class="artifact-label label-left" aria-hidden="true"><span>01 / INSPECT</span><i></i>Find the entry point</div>
  <div class="artifact-label label-right" aria-hidden="true"><span>02 / TRACE</span><i></i>Follow the behavior</div>
  <button class="motion-toggle" type="button" aria-label="Pause visual animation" aria-pressed="false" hidden>Pause motion <span aria-hidden="true">Ⅱ</span></button>
</div>
<script>
  const host=document.querySelector<HTMLElement>('.disassembly');
  if(host) import('../visual/disassembly').then(({mount})=>mount(host)).catch(()=>{host.dataset.renderer='static';});
</script>
