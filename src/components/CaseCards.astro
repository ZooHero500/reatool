---
import {caseStudies} from '../data/cases';
import '../styles/labs.css';
---
<section class="play-cases wrap" id="play-cases"><div class="section-top"><div><p class="eyebrow">FOUR NEW INVESTIGATIONS / HANDS ON</p><h2>Play it. Then find out why.</h2></div><a class="text-link" href="/tutorials/">Explore all tutorials <span>↗</span></a></div><div class="feature-grid">{caseStudies.map(study=><a class="feature-card" href={`/cases/${study.slug}/`}><div class="lab-card-art" aria-hidden="true">
  {study.slug==='dino'&&<svg viewBox="0 0 260 175"><path d="M20 125H240" stroke="#704051"/><path d="M78 95V68h28v13H91v12h15v8H91v11h-9v13h-8v-17H62v17h-8V98H43V83h7v10h12v2z" fill="#ff637f"/><path d="M197 125V93h8v13h7V83h8v42z" fill="#955366"/><text x="22" y="29" fill="#c07891" font-size="9" font-family="monospace">SPEED 6.000 → 13.001</text><path d="M41 151H138" stroke="#693243" stroke-width="3"/><circle cx="83" cy="151" r="5" fill="#ff7692"/></svg>}
  {study.slug==='th04'&&<svg viewBox="0 0 260 175">{Array.from({length:16},(_,i)=>{const a=(i*16+24)/256*Math.PI*2;return <><line x1="130" y1="88" x2={130+Math.cos(a)*63} y2={88+Math.sin(a)*63} stroke={i===0?'#ffb1c4':'#633047'}/><circle cx={130+Math.cos(a)*63} cy={88+Math.sin(a)*63} r="3" fill="#ef5277"/></>;})}<circle cx="130" cy="88" r="5" fill="#ffd8e4"/><path d="M203 130l7 7-7 7-7-7z" fill="#ffc0d1"/></svg>}
  {study.slug==='dx-ball'&&<svg viewBox="0 0 260 175"><text x="24" y="32" fill="#c07891" font-size="9" font-family="monospace">POSITION → STEREO</text><path d="M30 100H230" stroke="#603249"/><rect x="67" y="64" width="38" height="20" rx="2" fill="#ee4568" stroke="#ff9bb0"/><text x="30" y="139" fill="#dd9aaf" font-size="13">L</text><text x="220" y="139" fill="#dd9aaf" font-size="13">R</text><path d="M52 134H144 M160 134H207" stroke="#512b3c" stroke-width="5"/><path d="M52 134H126 M160 134H169" stroke="#f4658a" stroke-width="5"/></svg>}
  {study.slug==='calculator'&&<span class="lab-formula">200 + 10%<small>20 → 220</small></span>}
  </div><div class="feature-copy"><span class="lesson-kind">{study.category.toUpperCase()} · INTERACTIVE LAB</span><h3>{study.shortTitle}</h3><p>{study.slug==='dino'?'Change the pace. Jump the obstacle. Catch a surprising edge case.':study.slug==='th04'?'Move the player. Fire a ring. Decode the angles behind the pattern.':study.slug==='dx-ball'?'Move a brick from left to right. Hear the rule you are recovering.':'Press % and watch the operand change before you hit equals.'}</p><span class="lesson-action">Play & investigate <b>↗</b></span></div></a>)}</div></section>
