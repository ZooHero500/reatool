<div class="otp-demo">
  <div class="demo-bar"><span class="live-dot"></span> The 30-second code <span>INTERACTIVE LAB</span></div>
  <div class="otp-body"><p class="eyebrow">PUBLIC TEST KEY · SHA-1 · 6 DIGITS</p><output id="otp-code" aria-live="polite">287082</output><p class="otp-clock">Unix time <strong id="otp-seconds">59</strong>s <span>Counter <strong id="otp-counter">1</strong></span></p><label for="otp-time">Move time across the boundary</label><input type="range" id="otp-time" min="0" max="120" value="59" step="1"/><div class="range-labels"><span>0s</span><span>30s</span><span>60s</span><span>90s</span><span>120s</span></div><div class="otp-jumps"><button type="button" data-time="59">Go to 59s</button><button type="button" data-time="60">Go to 60s <span>→</span></button></div><p id="otp-status">59 ÷ 30 → counter 1. At 60 seconds, the counter becomes 2.</p></div>
  <p class="demo-privacy">New teaching implementation using RFC 6238’s public test key. No account secrets. No REA calls in your browser.</p>
</div>
<script>
  import {testCode} from '../lib/totp.mjs';
  import {t} from '../lib/i18n';
  const slider=document.querySelector<HTMLInputElement>('#otp-time')!;let revision=0;let digitAnimation:Animation|undefined;
  const output=document.getElementById('otp-code')!;const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  async function update(){
    const current=++revision;const seconds=Number(slider.value);
    try{
      const code=await testCode(seconds);if(current!==revision)return;
      const changed=output.textContent!==code;output.textContent=code;
      if(changed&&!reduced.matches){digitAnimation?.cancel();digitAnimation=output.animate([{opacity:.25,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:260,easing:'cubic-bezier(.16,1,.3,1)'});}
      document.getElementById('otp-seconds')!.textContent=String(seconds);document.getElementById('otp-counter')!.textContent=String(Math.floor(seconds/30));
      document.getElementById('otp-status')!.textContent=t('floor({seconds} ÷ 30) = {counter}. The same counter produces the same code.',{seconds,counter:Math.floor(seconds/30)});
      document.querySelectorAll<HTMLButtonElement>('[data-time]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.time)===seconds)));
    }catch{if(current!==revision)return;output.textContent='—';document.getElementById('otp-status')!.textContent=t('This demo needs WebCrypto on HTTPS or localhost.');}
  }
  slider.addEventListener('input',update);document.querySelectorAll<HTMLButtonElement>('[data-time]').forEach(b=>b.addEventListener('click',()=>{slider.value=b.dataset.time!;update();}));update();
</script>
